{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Copilot Overlay",
  "version": "1.0.0",
  "identifier": "com.local.copilot-overlay",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Copilot Overlay",
        "width": 300,
        "height": 600,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
